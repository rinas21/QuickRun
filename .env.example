# QuickRun — Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# In Replit, all these are pre-configured in the Secrets panel automatically.

# ── PostgreSQL ──────────────────────────────────────────────
# Full connection string (used by the Go API server)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# Individual PG connection params (optional, some tools prefer these)
PGHOST=localhost
PGPORT=5432
PGDATABASE=quickrun
PGUSER=postgres
PGPASSWORD=your_postgres_password

# ── Auth ────────────────────────────────────────────────────
# JWT signing secret — use a long random string in production
# Generate one with: openssl rand -base64 64
SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Per-Service Ports ────────────────────────────────────────
# Set these if running services locally (Replit injects these automatically)
# API server
PORT=8080

# Frontend (Vite dev server)
# PORT=5173
# BASE_PATH=/
