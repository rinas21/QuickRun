FROM node:22-alpine

WORKDIR /app

RUN npm install -g pnpm

# Copy root workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all packages/libs needed
COPY lib/ ./lib/
COPY artifacts/quickrun/ ./artifacts/quickrun/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the frontend
RUN pnpm --filter @workspace/quickrun build

EXPOSE 19572

# Serve using vite preview or a simple static server
CMD ["pnpm", "--filter", "@workspace/quickrun", "serve"]
